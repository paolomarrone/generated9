#!/usr/bin/env python3
"""Build and exercise native vmx inside generated9, using a Linux SMP guest."""
import argparse
import gzip
import lzma
import os
import pathlib
import select
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time

HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parents[4]


def archive(entries):
    """Write the small newc initramfs without requiring a host cpio program."""
    data = bytearray()
    for ino, (name, mode, body, major, minor) in enumerate(
        [*entries, ("TRAILER!!!", 0, b"", 0, 0)], 1
    ):
        name = name.encode() + b"\0"
        fields = [ino, mode, 0, 0, 1, 0, len(body), 0, 0, major, minor, len(name), 0]
        data += b"070701" + "".join(f"{v:08x}" for v in fields).encode() + name
        data += b"\0" * (-len(data) % 4)
        data += body
        data += b"\0" * (-len(data) % 4)
    return data


def module_bytes(path):
    data = path.read_bytes()
    if path.suffix == ".gz":
        return gzip.decompress(data)
    if path.suffix == ".xz":
        return lzma.decompress(data)
    if path.suffix == ".zst":
        # Python 3.14 has this in its standard library.
        from compression import zstd
        return zstd.decompress(data)
    return data


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("linux", type=pathlib.Path, help="Linux bzImage with SMP, MP tables and initramfs")
    parser.add_argument("--modules", help="installed Linux module version, if virtio is modular")
    parser.add_argument("--cpus", type=int, nargs="+", default=[1, 2, 4, 8])
    parser.add_argument("--timeout", type=int, default=900, help="seconds per guest")
    parser.add_argument("--host-cpus", type=int, default=4)
    parser.add_argument("--host-kernel", type=pathlib.Path, default=ROOT / "sys/src/9/pc64/9pc64")
    args = parser.parse_args()
    if any(n < 1 or n > 64 for n in args.cpus) or args.host_cpus < 1:
        parser.error("CPU counts must be positive; vmx supports at most 64")
    if args.timeout <= 0:
        parser.error("timeout must be positive")
    subprocess.run([str(ROOT / "boot/mkdirs")], check=True)
    work = pathlib.Path(tempfile.mkdtemp(prefix="vmx-smp-", dir=ROOT / "usr/glenda/tmp"))
    print(f"Test files and logs: {work}", flush=True)
    guest = "/tmp/" + work.name
    shutil.copyfile(args.linux, work / "linux")
    subprocess.run([os.environ.get("CC", "cc"), "-static", "-O2", "-pthread",
                    "-Wall", "-Wextra", "-Werror", "-o", str(work / "init"),
                    str(HERE / "linux.c")], check=True)
    entries = [("init", stat.S_IFREG | 0o755, (work / "init").read_bytes(), 0, 0),
               ("dev", stat.S_IFDIR | 0o755, b"", 0, 0),
               ("dev/console", stat.S_IFCHR | 0o600, b"", 5, 1)]
    module_names = []
    if args.modules:
        files = []
        for name in ("virtio_pci", "virtio_blk"):
            deps = subprocess.check_output(["modprobe", "--set-version", args.modules,
                                            "--show-depends", name], text=True)
            for line in deps.splitlines():
                fields = line.split()
                if fields[0] == "insmod" and fields[1] not in files:
                    files.append(fields[1])
        for i, path in enumerate(files):
            name = f"module{i}.ko"
            entries.append((name, stat.S_IFREG | 0o644, module_bytes(pathlib.Path(path)), 0, 0))
            module_names.append("/" + name)
    entries.append(("modules", stat.S_IFREG | 0o644,
                    "".join(n + "\n" for n in module_names).encode(), 0, 0))
    (work / "initramfs").write_bytes(archive(entries))

    command = [str(ROOT / "boot/qemu"), "-m", "4G", "-smp", str(args.host_cpus),
               "-kernel", str(args.host_kernel.resolve())]
    proc = subprocess.Popen(command, cwd=ROOT, stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            start_new_session=True)
    pending = b""
    console = (work / "host.log").open("wb")

    def read_console(timeout):
        nonlocal pending
        if select.select([proc.stdout], [], [], timeout)[0]:
            chunk = os.read(proc.stdout.fileno(), 65536)
            if not chunk:
                raise RuntimeError("host QEMU exited")
            console.write(chunk)
            console.flush()
            pending += chunk

    def wait_for(marker):
        nonlocal pending
        deadline = time.monotonic() + args.timeout
        while marker not in pending:
            if time.monotonic() >= deadline:
                raise RuntimeError(f"timeout waiting for {marker!r}; see host.log")
            read_console(0.25)
        pending = pending.split(marker, 1)[1]

    def send(command):
        proc.stdin.write(command.encode() + b"\n")
        proc.stdin.flush()

    try:
        wait_for(b"term% ")
        send(f"cd /sys/src/cmd/vmx && mk test >{guest}/build.log >[2=1] && "
             f"mk >>{guest}/build.log >[2=1]; "
             f"echo $status >{guest}/build.status; echo BUILD-DONE")
        wait_for(b"BUILD-DONE\r")
        wait_for(b"term% ")
        if (work / "build.status").read_text().strip():
            raise RuntimeError("native build failed; see build.log")
        send(f"mk test/6.device >>{guest}/build.log >[2=1] && "
             f"test/6.device >{guest}/device.log >[2=1]; "
             f"echo $status >{guest}/device.status; echo DEVICE-DONE")
        wait_for(b"DEVICE-DONE\r")
        wait_for(b"term% ")
        if (work / "device.status").read_text().strip():
            raise RuntimeError("device lifetime test failed; see device.log")
        print((work / "device.log").read_text().strip(), flush=True)
        for trial, count in enumerate(args.cpus):
            label = f"{trial}-{count}cpu"
            logfile = work / (label + ".log")
            monitor = work / (label + ".monitor")
            disk = work / (label + ".disk")
            logfile.touch()
            with disk.open("wb") as f:
                f.truncate(32 * 1024 * 1024)
            script = work / "run.rc"
            script.write_text(
                f"cd /sys/src/cmd/vmx\n"
                f"./6.out -P {count} -M 256M -d {guest}/{disk.name} "
                f"-c ,{guest}/{logfile.name} -m {guest}/initramfs {guest}/linux "
                f"'console=ttyS0 loglevel=7 rdinit=/init panic=-1 -- {count}' "
                f">{guest}/{monitor.name} >[2=1] &\n"
                f"echo $apid >{guest}/pid\n"
            )
            send(f"rc {guest}/run.rc")
            wait_for(b"term% ")
            deadline = time.monotonic() + args.timeout
            clockstart = clockend = None
            passed = f"VMX-SMP-PASS cpus={count} total={count*8*25000}"
            while True:
                log = logfile.read_text(errors="replace")
                now = time.monotonic()
                if clockstart is None and "VMX-CLOCK-START" in log:
                    clockstart = now
                if clockend is None and "VMX-CLOCK-END" in log:
                    clockend = now
                if any(marker in log for marker in
                       ("VMX-SMP-FAIL", "Kernel panic", "BUG: soft lockup", "hard LOCKUP")):
                    raise RuntimeError(f"guest failed: {logfile}")
                if passed in log:
                    break
                if time.monotonic() >= deadline:
                    raise RuntimeError(f"guest timed out: {logfile}")
                read_console(0.25)
            if count > 1:
                if clockstart is None or clockend is None or not 4 <= clockend-clockstart <= 7:
                    raise RuntimeError(f"guest clock rate differs from host: {logfile}")
                print(f"Guest sleep(5): {clockend-clockstart:.2f}s on host", flush=True)
            print(passed, flush=True)
            pid = (work / "pid").read_text().strip()
            if not pid.isdecimal():
                raise RuntimeError("invalid monitor PID")
            send(f"echo kill >/proc/{pid}/notepg")
            wait_for(b"term% ")
    finally:
        if proc.poll() is None:
            try:
                proc.stdin.write(b"\x01x")
                proc.stdin.flush()
                proc.wait(timeout=10)
            except (BrokenPipeError, subprocess.TimeoutExpired):
                if proc.poll() is None:
                    os.killpg(proc.pid, signal.SIGTERM)
                    proc.wait(timeout=10)
        console.close()
        proc.stdin.close()
        proc.stdout.close()


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(f"vmx/test/run: {error}")
