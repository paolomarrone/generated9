index 4bf88e0..a735d32 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -7299,2 +7299,5 @@ void vrend_renderer_poll(void) {
+      /* The caller may have made an unrelated GL context current. */
+      vrend_renderer_force_ctx_0();
